# 统一换行符：仓库内一律 LF（Windows 检出时按需转换）
* text=auto eol=lf

# 明确声明为文本的类型（避免被当成二进制）
*.cu    text
*.cuh   text
*.cpp   text
*.h     text
*.hpp   text
*.py    text
*.md    text
*.txt   text
*.sh    text
*.json  text
*.cmake text

# CMake 文件
CMakeLists.txt text

# 二进制（不要做换行转换）
*.png  binary
*.jpg  binary
*.pdf  binary
*.onnx binary
*.engine binary
